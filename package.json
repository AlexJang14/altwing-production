{
  "name": "altwing",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "guidance:freshness": "node scripts/check-guidance-freshness.mjs",
    "guidance:balance": "python3 scripts/check-engineering-match-balance.py",
    "test:submission": "node scripts/check-submission.mjs && npm run test:project-completion",
    "data:scorecard-probe": "node scripts/scorecard-api.mjs --probe",
    "data:scorecard-api": "node scripts/scorecard-api.mjs",
    "test:analytics": "node scripts/check-analytics.mjs",
    "test:atomic-ingestion": "node scripts/check-atomic-ingestion.mjs",
    "test:admin-access": "node scripts/check-admin-access.mjs",
    "test:research-assessment": "node scripts/check-research-assessment.mjs",
    "test:rights": "node scripts/check-rights.mjs",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "test:impact": "node scripts/check-impact.mjs",
    "test:cloudflare": "node scripts/check-cloudflare.mjs",
    "build:impact-preview": "vite build --config vite.impact-preview.config.ts",
    "test:impact-preview": "node scripts/check-impact-preview.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "npm start",
    "build:pages": "node scripts/build-pages.mjs",
    "build:pages:legacy": "node scripts/build-pages.mjs --legacy",
    "build:pages:preview": "node scripts/build-pages.mjs --preview",
    "test:migration": "node scripts/check-domain-migration.mjs",
    "test:pages": "node scripts/check-pages-build.mjs",
    "build:progress-bridge": "node scripts/build-progress-bridge.mjs",
    "test:progress-bridge": "node scripts/check-progress-bridge.mjs",
    "verify:migration": "node scripts/verify-domain-migration.mjs",
    "verify:release": "node scripts/check-release.mjs",
    "test:release": "node scripts/check-release-policy.mjs",
    "security:source": "node scripts/check-source-security.mjs",
    "check:domain": "node scripts/check-domain-live.mjs",
    "build:gold-preview": "vite build --config vite.gold-preview.config.ts && node scripts/package-gold-preview.mjs",
    "build:color-lab": "vite build --config vite.color-lab-frame.config.ts && vite build --config vite.color-lab.config.ts",
    "test:color-lab": "node scripts/check-color-lab.mjs",
    "build:golden-preview": "vite build --config vite.golden-horizon-frame.config.ts && vite build --config vite.golden-horizon.config.ts",
    "test:golden-horizon": "node scripts/check-golden-horizon.mjs",
    "content:dry-run": "python3 -B scripts/content-intelligence.py run",
    "content:validate": "python3 -B scripts/content-intelligence.py validate",
    "test:content": "python3 -B -m unittest discover -s scripts/content_intelligence -p \"test_*.py\" -v",
    "test:content:ui": "node scripts/check-content-ui.mjs",
    "test:content:workflows": "node scripts/check-content-workflows.mjs",
    "test:project-completion": "node scripts/check-project-completion.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-react-refresh": "0.4.26",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
